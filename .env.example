# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://oc12:mypassword@localhost:5432/oc12"

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

BETTER_AUTH_URL="http://localhost:5173"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft / Entra ID OAuth (https://portal.azure.com -> App registrations)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional: restrict to a single tenant instead of "common"
#MICROSOFT_TENANT_ID="common"
LOGO_PATH=
LOGO_DARK_PATH=
PUBLIC_ORGANIZATION_NAME=
# Set to true to enforce the Content-Security-Policy; leave empty to only report violations
CSP_ENFORCE=

# Booking confirmation emails (leave SMTP_HOST empty to turn email off)
SMTP_HOST=
SMTP_PORT=587
# true for port 465; false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Open Cupboard <noreply@example.org>"
MAIL_REPLY_TO=
# Times in emails are shown in this zone
TIMEZONE=America/Toronto
# Optional: folder of .txt templates that override the built-in ones
EMAIL_TEMPLATE_DIR=
