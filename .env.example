# PostgreSQL connection string used by Prisma.
# This is used for running locally with a local database or a remote database.
# If you are using docker-compose, you can set the POSTGRES_USER, POSTGRES_PASSWORD and POSTGRES_DB environment variables in the docker-compose.yml file instead of DATABASE_URL.
DATABASE_URL="postgresql://myuser:mypassword@localhost:5432/mydatabase"

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:5173"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft / Entra ID OAuth (https://portal.azure.com -> App registrations)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional: restrict to a single tenant instead of "common"
# MICROSOFT_TENANT_ID="common"

# Optional: path to logo files (relative to the public folder) to show on the login page and menu bar. If not set, the default logo is used.
# LOGO_PATH=
# LOGO_DARK_PATH=

# Optional: Custom name of the organization to show on the login page and menu bar. If not set, the default name is used.
# ORGANIZATION_NAME=

# Set to true to enforce the Content-Security-Policy; leave empty to only report violations
# CSP_ENFORCE=

# Notification email server configuration (leave SMTP_HOST empty to turn email off)
# SMTP_HOST=
# SMTP_PORT=587
# true for port 465; false for 587 (STARTTLS)
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="Open Cupboard <noreply@opencupboard.ca>"
# MAIL_REPLY_TO=
# Times in emails are shown in this zone
# TIMEZONE=America/Toronto

# Optional: folder of .txt templates that override the built-in ones
# EMAIL_TEMPLATE_DIR=

# Optionally set the maximum upload size in MB (default is 10_MB)
# MAX_UPLOAD_MB=10

# Tabs on the household page, comma-separated "Name:Icon" pairs (icon optional)
# Default is "Special Requests"
# DATED_REQUEST_TYPES="Special:QuestionCircle, Prayer:Heart, Other:Star"

# Country filled in when creating households, volunteers and sites
# DEFAULT_COUNTRY="Canada"  

# Optional city filled in when creating households, volunteers and sites  
# DEFAULT_CITY=

# Optionally set the default state/province filled in when creating households, volunteers and sites. Default value is "Province"
# STATE_DISPLAY_NAME: "Province"

# Optionally set the default state/province filled in when creating households, volunteers and sites. Default value is "Ontario"
# DEFAULT_STATE: "Ontario"

# Show the "Family size" tile on the household page (true/false). Default: true
# SHOW_HOUSEHOLD_SIZE=true

# Let more volunteers sign up for a shift than the number needed (true/false). Default: false
# ALLOW_VOLUNTEER_OVERBOOKING=false 

# How long a sign-in lasts, in days (fractions allowed, e.g. 0.5). Default: 7
# AUTH_SESSION_DAYS=7

# How long a user ID lasts before it must be reverified, in months. Default: 6
# ID_RENEWAL_PERIOD_MONTHS=6

# Optional: the the locale to use for formatting dates in the UI. Default: "en-CA". See https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Date/toLocaleDateString for supported locales.
# DATE_LOCALIZATION: "en-CA"

# Optional: The number of days between appointments for a household. Default: 28
# APPOINTMENT_FREQUENCY_DAYS=28