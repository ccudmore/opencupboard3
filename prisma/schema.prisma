model DatedRequest {
  id                    String        @id @default(cuid())
  household             Household     @relation("DatedRequestMembership", fields: [householdId], references: [id])
  householdId           String
  requestText           String?
  status                String?
  type                  String?
  createdAt             DateTime        @default(now())
  createdBy             String?
}

model Household {
  id                    String        @id @default(cuid())
  status                String        @default("Active")
  uniqueId              String?
  datedRequests         DatedRequest[] @relation("DatedRequestMembership")
  //datedRequest          String[]
  dietaryRestrictions   String[]
  pets                  String?
  notes                 String?
  preferredServiceTypes String[]
  preferredTimeOfDay    String[]
  languagesSpoken       String[]
  howHeard              String?
  street      String?
  street2     String?
  city        String?
  postalCode  String?
  province    String
  country     String
  appointments          Appointment[]
  members               Guest[] @relation("HouseholdMembership")
  createdAt     DateTime        @default(now())
  createdBy   String?
}
/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model Volunteer {
  id              String  @id @default(cuid())
  //person          Person  @relation(fields: [personId], references: [id])
  //personId        String  @unique
  firstName       String
  lastName        String
  fullName        String
  street          String?
  city        String?
  postalCode  String?
  province    String   @default("Ontario")
  country     String   @default("Canada")
  email1      String?
  email2      String?
  phone1      String?
  phone2      String?
  availability    Json?
  attachments     Json?
  trainingCourses Json?
  assignments VolunteerAssignments[]
  createdAt     DateTime        @default(now())
  createdBy   String?
}

model VolunteerAssignments {
  volunteer Volunteer @relation(fields: [volunteerId], references: [id])
  volunteerId String
  event Event @relation(fields: [eventId], references: [id])
  eventId String
  eventRole String
  status String
  @@id([volunteerId, eventId, eventRole])
  createdAt     DateTime        @default(now())
  createdBy   String?
}