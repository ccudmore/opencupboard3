    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "db:seed": "prisma db seed",
    "db:reference": "tsx prisma/seed-reference.ts",
    "db:bootstrap-admin": "tsx prisma/bootstrap-admin.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "flowbite": "^4.0.2",
    "flowbite-svelte": "^1.33.1",
    "flowbite-svelte-icons": "^3.1.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.5",
    "sveltekit-superforms": "^3.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "^1.7.5",
    "dotenv": "^18.0.3",
    "flowbite-svelte-blocks": "^1.1.4",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.11.2",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.0",
    "prisma": "^7.10.1",
    "svelte-sonner": "^1.2.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "zxing-wasm": "^3.1.6"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*",
    "#prisma/client": "./prisma/src/generated/prisma/client.ts",
